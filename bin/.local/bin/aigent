#!/usr/bin/env sh
# aigent is now trails: https://github.com/gunasekar/trails, installed by the Brewfile
# (brew "gunasekar/tap/trails"). This shim forwards everything to it.
#
# It stays for one reason that outlives habit. Every agent started before the rename runs
# under a wrapper that calls this exact path as `--forget aigent-<name>` when the agent
# exits. Those sessions were renamed trails-<name>, so the name is translated here, or a
# session you quit would leave its record behind and come back as a ↻ row.
#
# Safe to delete once no aigent-era agent is left: `pgrep -f aigent-wrap` prints nothing.

# The wrapper runs with whatever PATH the tmux server started with, so make sure Homebrew's
# bin is on it whichever prefix this machine uses.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin"

case $1 in
  --forget)
    exec trails --forget "trails-${2#aigent-}"
    ;;
  *) ;; # anything else is you, by habit
esac
echo "aigent is now trails — run \`trails\` instead" >&2
exec trails "$@"
