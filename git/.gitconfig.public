# Generic Git Configuration (Public)

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[commit]
	template = ~/.git-commit-template
[push]
	autoSetupRemote = true
[diff]
	tool = vimdiff
	colorMoved = default
[difftool]
	prompt = false
[core]
	pager = delta
	excludesFile = ~/.global.gitignore
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	tabs = 2
	# Dim decorations (default is bright blue). Side-by-side only via LazyGit `|`
	# or: DELTA_FEATURES=+side-by-side git diff
	file-decoration-style = "238 ul"
	hunk-header-decoration-style = "238 box"
	hunk-header-style = raw
	line-numbers-left-style = 238
	line-numbers-right-style = 238
[merge]
	conflictstyle = diff3
